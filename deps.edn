;; wallet — non-custodial multi-chain wallet (MetaMask/Coinbase Wallet-shaped):
;; a single BIP-32/39/44 seed, a ChainDriver registry (:eth, :btc), real
;; SIWE/EIP-4361 (personal_sign + ecrecover, verifiable by real Ethereum
;; tooling), and a local encrypted-keystore shape. Builds on btc-crypto
;; (shared secp256k1 HD tree + BTC addresses/tx) and eth-crypto (ETH
;; addresses/tx/keccak) rather than re-deriving them.
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/btc-crypto {:git/sha "675f893826db1b01994c7ef9bf9002a2669d54da"}
        io.github.kotoba-lang/eth-crypto {:git/sha "2b0e56d28262eb1b513cee6c822a55714303f39a"}
        io.github.kotoba-lang/crypto     {:git/sha "c4f825c166c0095f7b020c503c56a0a1fb10af07"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
